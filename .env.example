# 复制此文件为 .env 后填写；已有 .env 时仅补充新字段，不要覆盖原配置。
# 示例文件不存放真实密钥。CLI 使用 --env-file .env 私下加载。
# 当前 PowerShell 会话可执行：. .\scripts\load_env.ps1

# 阶段三：对话 LLM（DeepSeek 官方 API，与百炼向量/重排独立）
INSURANCE_CHAT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-flash
# 首版采用非思考模式；主图负责业务编排，后续可独立评估开启。
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_CHAT_TIMEOUT_SECONDS=30
DEEPSEEK_CHAT_MAX_OUTPUT_TOKENS=2048
# Offline formula extraction budget; interactive chat keeps its own limit.
INSURANCE_FORMULA_MAX_OUTPUT_TOKENS=6144
DEEPSEEK_CHAT_RETRIES=1

# Agent：沿用已验证的开发发布环境；正式数据未审核时不得改作生产环境。
INSURANCE_AGENT_ENVIRONMENT=dev-agent

# 阶段二：百炼 Embedding / 重排，继续使用独立密钥
DASHSCOPE_API_KEY=
# 填写原工作空间接口，包含 /compatible-mode/v1，不含 /embeddings 路径。
# 默认公开接口示例；已有实际 .env 的区域/工作空间地址保持原值。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
DASHSCOPE_EMBEDDING_DIMENSION=1024
DASHSCOPE_RERANK_MODEL=qwen3.7-text-rerank

# 本地数据库与 OpenSearch；不把真实密码放入示例。
# 格式：postgresql://用户名:密码@127.0.0.1:5432/数据库名
INSURANCE_POSTGRES_DSN=
# 使用内置Compose时填入同一PostgreSQL密码；不要使用真实密码作为示例。
INSURANCE_POSTGRES_PASSWORD=
INSURANCE_OPENSEARCH_URL=http://127.0.0.1:9200
INSURANCE_OPENSEARCH_USER=
INSURANCE_OPENSEARCH_PASSWORD=
INSURANCE_PROJECT_ROOT=

# 可选：空的隔离恢复数据库，不能使用主数据库。
INSURANCE_RESTORE_POSTGRES_DSN=

# 本地 Agent API 认证令牌，与模型密钥不同；留空时 API 拒绝业务请求。
INSURANCE_AGENT_API_TOKEN=
# Agent 复用阶段二混合检索；诊断时可显式选择 bm25。
INSURANCE_AGENT_RETRIEVAL_MODE=rrf

# Stage four work limits (no additional API key required)

# 已有产品复杂条件的有界澄清轮数（默认6，上限8）

# 公式计算单独使用同一 DeepSeek Flash 的推理模式；普通检索保持原设置。

# Native Agent loop（显式 --runtime loop；变更后重启服务并新建会话）
INSURANCE_LOOP_MAX_STEPS=12
INSURANCE_LOOP_MAX_MODEL_CALLS=12
INSURANCE_LOOP_MAX_TOOL_CALLS=24
INSURANCE_LOOP_MAX_REPAIRS=2
INSURANCE_LOOP_MAX_CLARIFICATIONS=3
INSURANCE_LOOP_TIMEOUT_SECONDS=180
INSURANCE_LOOP_CONTEXT_BYTES=96000
INSURANCE_LOOP_MAX_TOTAL_TOKENS=500000

# Optional independent administrator credential; ordinary API/session access does not grant review/publish.
# For loopback development use serve_agent.py --local-test --local-admin instead.
INSURANCE_ADMIN_API_TOKEN=

# Optional authorized local output directory (defaults to <project>/local_files).
# INSURANCE_LOCAL_FILES_ROOT=C:/your-authorized-directory
