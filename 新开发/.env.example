# 复制为 .env 后按需修改；.env 不提交。
# 业务 API 内部访问令牌（开发默认值，生产必须替换）
INTERNAL_API_TOKEN=dev-internal-token
API_PORT=3001
API_HOST=127.0.0.1

# 产品库与采集运行库（Docker MySQL，映射 3307）
DATABASE_URL=mysql://baoxian:baoxian_dev@127.0.0.1:3307/baoxian_product
CRAWL_DATABASE_URL=mysql://baoxian:baoxian_dev@127.0.0.1:3307/baoxian_crawl

# API 测试专用库；每个用例前清空业务表
TEST_DATABASE_URL=mysql://baoxian:baoxian_dev@127.0.0.1:3307/baoxian_product_test
TEST_CRAWL_DATABASE_URL=mysql://baoxian:baoxian_dev@127.0.0.1:3307/baoxian_crawl_test

# Redis：0 开发，1 测试；BullMQ 队列名
REDIS_URL=redis://:baoxian_redis_dev@127.0.0.1:6379/0
TEST_REDIS_URL=redis://:baoxian_redis_dev@127.0.0.1:6379/1
CRAWL_QUEUE_NAME=crawl

# MinIO 原件与来源快照
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=baoxian
MINIO_SECRET_KEY=baoxian_minio_dev
MINIO_BUCKET=baoxian-documents
# 索引数据源：real 使用协会真实接口，fixture 使用本地开发样本
ASSOCIATION_SOURCE=real
